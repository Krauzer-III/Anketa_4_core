@model Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_ResultDetail
@{
    var kt = Model.Data.KettelTest;
    var questions = kt?.QA?.OrderBy(x => int.TryParse(x.QuestionNumber, out var n) ? n : int.MaxValue)
        .ToList();
    var categories = kt?.Results?.OrderBy(x => x.CategoryName).ToList();
    bool hasAnswers = questions?.Count > 0;
    bool completed = kt?.IsCompleted == true || categories?.Count > 0;
}
<h6>Оцениваемый: <strong>@Model.TestableCode</strong></h6>
<p class="text-muted">Период: @Model.PeriodName · доступ №@Model.AccessID</p>

@if (!hasAnswers && !completed)
{
    <div class="alert alert-secondary">Психологическое тестирование ещё не начато.</div>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <strong>Статус:</strong>
            <span class="badge @(completed ? "text-bg-success" : "text-bg-warning")">
                @(completed ? "Пройден" : "В процессе")
            </span>
        </div>
        <div class="col-md-4"><strong>Отвечено:</strong> @(questions?.Count ?? 0)</div>
        <div class="col-md-4"><strong>Пол / возраст:</strong>
            @(string.IsNullOrWhiteSpace(kt?.Gender) ? "—" : kt.Gender)
            / @(kt?.Years > 0 ? kt.Years.ToString() : "—")
        </div>
    </div>
    @if (hasAnswers)
    {
        var dates = questions!.Where(x => x.DateTimeAnswer != default).Select(x => x.DateTimeAnswer).ToArray();
        if (dates.Length > 0)
        {
            <p class="text-muted">
                Первый ответ: @dates.Min().ToString("dd.MM.yyyy HH:mm:ss");
                последний ответ: @dates.Max().ToString("dd.MM.yyyy HH:mm:ss")
            </p>
        }
    }

    @if (completed && categories?.Count > 0)
    {
        <h6>Итоговые показатели (рассчитаны при завершении)</h6>
        <table class="table table-bordered table-sm table-striped">
            <thead><tr><th>Категория</th><th>Сырой балл</th><th>Нормированная оценка</th><th>Уровень</th></tr></thead>
            <tbody>
                @foreach (var item in categories)
                {
                    <tr>
                        <td>@item.CategoryName</td>
                        <td>@item.RawScore</td>
                        <td>@item.CategoryBall</td>
                        <td>@item.CategoryLevel</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning">
            Тест не завершён — итоговые оценки будут доступны после ответа на последний вопрос.
        </div>
    }

    @if (hasAnswers)
    {
        <details class="mt-3">
            <summary class="fw-semibold" style="cursor:pointer">
                Просмотр вопросов и ответов (@questions!.Count)
            </summary>
            <div class="table-responsive mt-2">
                <table class="table table-sm table-bordered">
                    <thead><tr><th>№</th><th>Вопрос</th><th>Ответ</th><th>Дата и время</th></tr></thead>
                    <tbody>
                        @foreach (var item in questions!)
                        {
                            <tr>
                                <td>@item.QuestionNumber</td>
                                <td>@item.QuestionText</td>
                                <td>@(item.AnswerNumber). @item.AnswerText</td>
                                <td>
                                    @(item.DateTimeAnswer == default
                                        ? "—" : item.DateTimeAnswer.ToString("dd.MM.yyyy HH:mm:ss"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
}
