@model Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestPeriodDetails
@{
    ViewData["Title"] = "Период: " + Model.PeriodName;
}
<h2 class="mb-3">@ViewData["Title"]</h2>

<div class="mb-3">
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Редактировать</a>
    <a class="btn btn-secondary" asp-action="Index">Назад к периодам</a>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Привязанные тестируемые</h5>
        @if (Model.BoundTestables.Count == 0)
        {
            <p class="text-muted">Нет привязанных тестируемых.</p>
        }
        else
        {
            <table class="table table-sm table-bordered align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Код</th>
                        <th>Филиал</th>
                        <th>Активен</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.BoundTestables)
                    {
                        <tr>
                            <td>@t.TestableId</td>
                            <td>@t.Code</td>
                            <td>@t.Filial</td>
                            <td>@(t.IsActive ? "Да" : "Нет")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Testable"
                                   asp-action="Details"
                                   asp-route-id="@t.TestableId">Профиль</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
