@model IEnumerable<Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestPeriodListItem>
@{
    ViewData["Title"] = "Периоды тестирования";
    bool canManage = User.IsInRole("admin") || User.IsInRole("moderator");
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-2">Периоды тестирования</h1>
        <p class="text-muted mb-0">Назначения, сроки и доступность тестирования.</p>
    </div>
    @if (canManage)
    {
        <a class="btn btn-primary" asp-action="Create">Добавить период</a>
    }
</div>
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">№</th>
                        <th scope="col">Период</th>
                        <th scope="col">Назначенных тестируемых</th>
                        <th scope="col" class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td class="fw-semibold">@p.PeriodName</td>
                            <td>@p.CountTestables</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details"
                                   asp-route-id="@p.Id">Подробности</a>
                                @if (canManage)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit"
                                       asp-route-id="@p.Id">Редактировать</a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Периоды пока не созданы.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
