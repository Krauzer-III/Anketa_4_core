@model IEnumerable<Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestPeriodListItem>
@{
    ViewData["Title"] = "Периоды тестирования";
}
<h2 class="mb-3">@ViewData["Title"]</h2>

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Добавить период</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название периода</th>
            <th>Привязок</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.PeriodName</td>
                <td>@p.CountTestables</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.Id">Подробности</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Редактировать</a>
                </td>
            </tr>
        }
    </tbody>
</table>
