@model IEnumerable<Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestPeriodListItem>
@{
    ViewData["Title"] = "Периоды тестирования";
}

<section class="app-page-heading">
    <div>
        <span class="app-page-eyebrow">Управление оценкой</span>
        <h1>Периоды тестирования</h1>
        <p>Назначения тестируемых и сведения о периодах проведения оценки.</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-primary" asp-controller="Period" asp-action="Create">Добавить период</a>
    </div>
</section>

<div class="card app-data-card">
    <div class="card-header">
        <h2 class="h5 mb-0">Все периоды</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название периода</th>
                    <th>Назначений</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td><strong>@p.PeriodName</strong></td>
                        <td>@p.CountTestables</td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="Period" asp-action="Details"
                                   asp-route-id="@p.Id">Подробности</a>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-controller="Period" asp-action="Edit"
                                   asp-route-id="@p.Id">Редактировать</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
