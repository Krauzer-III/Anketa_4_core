@model Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestPeriodCreate
@{
    ViewData["Title"] = "Добавить период";
}
<h2 class="mb-3">@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="PeriodName" class="form-label"></label>
        <input asp-for="PeriodName" class="form-control" />
        <span asp-validation-for="PeriodName" class="text-danger"></span>
    </div>

    <p class="text-muted">
        Период можно создать без тестируемых. Привязать сотрудников можно позже,
        открыв страницу редактирования периода.
    </p>

    <details class="border rounded p-3 mb-3">
        <summary class="fw-semibold">Привязать тестируемых при создании (необязательно)</summary>
        <div class="mt-3">
            @if (Model.AllTestables.Count == 0)
            {
                <p class="text-muted mb-0">Тестируемых пока нет. Период всё равно можно создать.</p>
            }
            else
            {
                <label asp-for="SelectedTestableIds" class="form-label"></label>
                <select asp-for="SelectedTestableIds" multiple class="form-select" size="10">
                    @foreach (var t in Model.AllTestables)
                    {
                        <option value="@t.id">@t.name @(string.IsNullOrEmpty(t.filial) ? "" : $"({t.filial})")</option>
                    }
                </select>
                <span asp-validation-for="SelectedTestableIds" class="text-danger"></span>
                <div class="form-text">Не выбирайте ничего, если привязки пока не нужны.</div>
            }
        </div>
    </details>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Создать</button>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
