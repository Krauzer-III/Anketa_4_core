@{
    ViewData["Title"] = "Личный кабинет";
    ViewData["LKCompact"] = false;
    ViewData["LKDataUrl"] = Url.Action("Data", "PersonalCabinet");
    ViewData["LKSaveUrl"] = Url.Action("SaveSection", "PersonalCabinet");
    ViewData["LKRatingUrl"] = Url.Action("Rating", "PersonalCabinet");
}
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h2 class="mb-1">Личный кабинет</h2>
            <p class="text-muted mb-0">
                Все таблицы размещены на этой странице. Для изменения данных
                нажмите «Редактировать» у нужного раздела; сохранение происходит без перезагрузки.
            </p>
        </div>
        <a asp-controller="Report" asp-action="GetReport"
           class="btn btn-success">Получить отчёт</a>
    </div>
    <partial name="_LKDashboard" />
</div>
