@{
    ViewData["Title"] = "Личный кабинет";
    ViewData["LKCompact"] = false;
    ViewData["LKDataUrl"] = Url.Action("Data", "PersonalCabinet");
    ViewData["LKSaveUrl"] = Url.Action("SaveSection", "PersonalCabinet");
    ViewData["LKRatingUrl"] = Url.Action("Rating", "PersonalCabinet");
}

<div class="py-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h2 class="mb-1">Личный кабинет</h2>
            <p class="text-muted mb-0">
                Индивидуальный план подготовки и развивающие мероприятия.
                Для редактирования раздела нажмите «Редактировать».
            </p>
        </div>
        <a class="btn btn-success" asp-controller="Report" asp-action="GetReport">
            Получить отчёт
        </a>
    </div>
    <partial name="_LKDashboard" />
</div>
