@model IEnumerable<Anketa_4_core.Data.AnketaModels.News>
@{
    ViewData["Title"] = "Управление новостями";
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-2">Управление новостями</h1>
        <p class="text-muted mb-0">Публикация и редактирование информационных сообщений системы.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Добавить новость</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">№</th>
                        <th scope="col">Заголовок</th>
                        <th scope="col">Дата публикации</th>
                        <th scope="col" class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model)
                    {
                        <tr>
                            <td>@n.ID</td>
                            <td class="fw-semibold">@n.Header</td>
                            <td>@n.DateNews.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.ID">Редактировать</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@n.ID">Удалить</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Новостей пока нет.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
