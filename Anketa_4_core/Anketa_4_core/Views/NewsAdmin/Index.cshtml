@model IEnumerable<Anketa_4_core.Data.AnketaModels.News>
@{
    ViewData["Title"] = "Управление новостями";
}
<h2 class="mb-3">@ViewData["Title"]</h2>

<div class="mb-3 d-flex gap-2">
    <a class="btn btn-primary" asp-action="Create">Добавить новость</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Заголовок</th>
            <th>Дата</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td>@n.ID</td>
                <td>@n.Header</td>
                <td>@n.DateNews.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.ID">Редактировать</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@n.ID">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
