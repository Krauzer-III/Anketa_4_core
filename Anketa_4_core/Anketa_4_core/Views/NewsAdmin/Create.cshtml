@model Anketa_4_core.Data.AnketaModels.News
@{
    ViewData["Title"] = "Добавить новость";
}
<h2 class="mb-3">@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Header" class="form-label"></label>
        <input asp-for="Header" class="form-control" />
        <span asp-validation-for="Header" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label"></label>
        <textarea asp-for="Body" class="form-control wysiwyg"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateNews" class="form-label"></label>
        <input class="form-control" value="@Model.DateNews.ToLocalTime().ToString("dd.MM.yyyy HH:mm")" disabled />
        <div class="form-text">Дата публикации сохраняется автоматически.</div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_WysiwygInit" />
}
