@{
    ViewData["Title"] = "Мотивационный опросник — ошибка";
}
<div class="container mt-5">
    <h2>При попытке начать оценку произошла ошибка</h2>
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Произошла ошибка</h4>
        <p>@ViewBag.Error</p>
    </div>
    <a asp-action="Index" asp-controller="Motivation" class="btn btn-primary">Вернуться к началу</a>
</div>
