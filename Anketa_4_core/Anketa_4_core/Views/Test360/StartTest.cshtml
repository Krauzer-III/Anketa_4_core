@using Anketa_4_core.Helpers
@model Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_Test360_StartTest_Model
@{
    ViewData["Title"] = "Начало тестирования";
}

<div class="container mt-5">
    <h2>Начало тестирования 360°</h2>
    <hr />

    <form asp-action="StartTest" method="post">
        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RoleID" class="form-label"></label>
            @Html.DDL_RespondentRoles(new[] { "form-control" }, "RoleID")
            <span asp-validation-for="RoleID" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Перейти к тесту</button>
    </form>

    <div class="mt-3 text-danger">
        @Html.ValidationSummary()
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}