@model Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_KettelModel_Main
@{
    ViewData["Title"] = "Тест Кэттелла – начало";
}
<h2>@ViewData["Title"]</h2>

<form asp-action="Start" method="post">
    <input type="hidden" asp-for="AccessID" />

    <div class="mb-3">
        <label asp-for="Years" class="form-label"></label>
        <input asp-for="Years" class="form-control" type="number" min="1" max="120" />
        <span asp-validation-for="Years" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Пол</label>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="Gender" value="M" id="genderM" />
            <label class="form-check-label" for="genderM">Мужской</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="Gender" value="F" id="genderF" />
            <label class="form-check-label" for="genderF">Женский</label>
        </div>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Начать тест</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
