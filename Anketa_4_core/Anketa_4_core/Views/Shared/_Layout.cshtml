<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Оценка персонала</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Anketa_4_core.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @* Авторская заставка сохранена из исходного интерфейса системы. *@
        <div class="banner">
            <p>Автоматизированная система "Оценка персонала"</p>
        </div>
        <nav class="navbar bg-body-tertiary" aria-label="Основная навигация">
            <div class="container-fluid">
                @* Привычное меню слева на любом устройстве. *@
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar"
                        aria-label="Открыть навигационное меню">
                    <span class="icon-menu" aria-hidden="true"></span>
                </button>
                <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasNavbar"
                     aria-labelledby="offcanvasNavbarLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="offcanvasNavbarLabel">Навигационное меню</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                                aria-label="Закрыть меню"></button>
                    </div>
                    <div class="offcanvas-body">
                        <partial name="_RoleMenu" />
                    </div>
                </div>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year — Оценка персонала
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
