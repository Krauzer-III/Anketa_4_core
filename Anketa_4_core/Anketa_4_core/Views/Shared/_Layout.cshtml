<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173b60" />
    <title>@ViewData["Title"] — Система оценки персонала</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/icons/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Anketa_4_core.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar app-navbar" aria-label="Навигация по системе">
            <div class="container-fluid app-nav-container">
                <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index"
                   aria-label="Система оценки персонала — главная">
                    <span class="app-brand-mark" aria-hidden="true">ОП</span>
                    <span class="app-brand-text">
                        <strong>Оценка персонала</strong>
                        <small>Автоматизированная система</small>
                    </span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav app-desktop-menu d-none d-xl-flex flex-row align-items-center gap-1">
                        <partial name="_NavigationLinks" />
                    </ul>
                }

                <div class="app-navbar-actions">
                    <partial name="_LoginPartial" />
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="navbar-toggler app-mobile-toggle d-xl-none" type="button"
                                data-bs-toggle="offcanvas" data-bs-target="#appMobileMenu"
                                aria-controls="appMobileMenu" aria-label="Открыть меню">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    }
                </div>
            </div>
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="offcanvas offcanvas-start app-offcanvas" tabindex="-1"
                 id="appMobileMenu" aria-labelledby="appMobileMenuLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="appMobileMenuLabel">Разделы системы</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                            aria-label="Закрыть меню"></button>
                </div>
                <div class="offcanvas-body">
                    <ul class="navbar-nav app-mobile-menu">
                        <partial name="_NavigationLinks" />
                    </ul>
                </div>
            </div>
        }
    </header>

    <div class="app-page">
        <main class="app-main container-fluid" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container-fluid app-footer-inner">
            <span>Автоматизированная система «Оценка персонала»</span>
            <span>© @DateTime.Now.Year</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
