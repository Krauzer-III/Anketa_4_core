@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="app-session">
        <span class="app-session-name" title="@User.Identity?.Name">@User.Identity?.Name</span>
        <form method="post" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm app-signout">Выйти</button>
        </form>
    </div>
}
else
{
    <a class="btn btn-sm app-signin" asp-area="Identity" asp-page="/Account/Login">
        Войти
    </a>
}
