@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool personal = User.IsInRole("testable_user");
    bool admin = User.IsInRole("admin");
    bool moderator = User.IsInRole("moderator");
    bool verifier = User.IsInRole("verificator");
    bool filial = User.IsInRole("filial_user");
    bool canManage = admin || moderator;
    bool canViewResults = canManage || verifier;
    bool canTest = personal || filial;
    bool testingActive = currentController == "Test360" ||
        currentController == "Motivation" ||
        currentController == "Kettel" ||
        currentController == "Competention";
}
@if (personal)
{
    <li class="nav-item">
        <a class="nav-link @(currentController == "PersonalCabinet" ? "active" : "")"
           asp-controller="PersonalCabinet" asp-action="Index">Личный кабинет</a>
    </li>
}
@if (filial && !personal)
{
    <li class="nav-item">
        <a class="nav-link @(currentController == "Home" ? "active" : "")"
           asp-controller="Home" asp-action="Index">Главная</a>
    </li>
}
@if (canTest)
{
    <li class="nav-item dropdown">
        <button type="button" class="nav-link dropdown-toggle @(testingActive ? "active" : "")"
                data-bs-toggle="dropdown" aria-expanded="false">Тестирование</button>
        <ul class="dropdown-menu app-dropdown">
            <li><a class="dropdown-item" asp-controller="Test360" asp-action="StartTest">Оценка 360°</a></li>
            <li><a class="dropdown-item" asp-controller="Motivation" asp-action="Index">Мотивационный опросник</a></li>
            <li><a class="dropdown-item" asp-controller="Kettel" asp-action="Index">Психологическое тестирование</a></li>
            <li><hr class="dropdown-divider" /></li>
            @if (personal)
            {
                <li><a class="dropdown-item" asp-controller="Competention" asp-action="Index">Компетенции (мой год обучения)</a></li>
            }
            else
            {
                <li><a class="dropdown-item" asp-controller="Competention" asp-action="Index" asp-route-year="1">Компетенции (1 год)</a></li>
                <li><a class="dropdown-item" asp-controller="Competention" asp-action="Index" asp-route-year="2">Компетенции (2 год)</a></li>
            }
        </ul>
    </li>
}
@if (canManage)
{
    <li class="nav-item">
        <a class="nav-link @(currentController == "Testable" ? "active" : "")"
           asp-controller="Testable" asp-action="Index">Тестируемые</a>
    </li>
}
@if (canViewResults)
{
    <li class="nav-item">
        <a class="nav-link @(currentController == "Period" ? "active" : "")"
           asp-controller="Period" asp-action="Index">Периоды</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentController == "Result" ? "active" : "")"
           asp-controller="Result" asp-action="IndexModerator">Результаты</a>
    </li>
}
@if (canManage)
{
    <li class="nav-item dropdown">
        <button type="button" class="nav-link dropdown-toggle @(currentController == "Registration" || currentController == "NewsAdmin" ? "active" : "")"
                data-bs-toggle="dropdown" aria-expanded="false">Управление</button>
        <ul class="dropdown-menu app-dropdown">
            <li><a class="dropdown-item" asp-controller="Registration" asp-action="Index">Регистрация пользователей</a></li>
            <li><a class="dropdown-item" asp-controller="NewsAdmin" asp-action="Index">Управление новостями</a></li>
        </ul>
    </li>
}
