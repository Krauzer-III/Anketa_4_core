@model Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestableDeletePreview
@{
    ViewData["Title"] = $"Удаление #{Model.Id}";
}
<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning">Вы собираетесь удалить тестируемого и все его связи. Проверьте данные ниже. Перед удалением вы можете сохранить их в архив. <strong>Операция необратима.</strong></div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Сводные данные</h5>
                <dl class="row">
                    <dt class="col-sm-4">Код</dt>
                    <dd class="col-sm-8">@Model.Code</dd>
                    <dt class="col-sm-4">Год</dt>
                    <dd class="col-sm-8">@Model.YearTraining</dd>
                    <dt class="col-sm-4">Филиал</dt>
                    <dd class="col-sm-8">@Model.Filial</dd>
                    <dt class="col-sm-4">Уровень резерва</dt>
                    <dd class="col-sm-8">@Model.ReservLevel</dd>
                    <dt class="col-sm-4">UserName</dt>
                    <dd class="col-sm-8">@Model.UserName</dd>
                    <dt class="col-sm-4">LK_Data</dt>
                    <dd class="col-sm-8"><pre class="mb-0">@Model.LK_Data</pre></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Периоды доступа</h5>
                @if (Model.BoundTestPeriods.Count == 0)
                {
                    <p class="text-muted">Нет привязок</p>
                }
                else
                {
                    <ul>
                        @foreach (var p in Model.BoundTestPeriods)
                        {
                            <li>@p.name</li>
                        }
                    </ul>
                }
                <p class="text-muted">Всего связей: @Model.AccessLinksCount</p>
            </div>
        </div>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="mb-2">// TODO: здесь можно добавить чекбокс/кнопку для предварительного архивирования</div>
    <button type="submit" class="btn btn-danger">Удалить окончательно</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Отмена</a>
</form>
