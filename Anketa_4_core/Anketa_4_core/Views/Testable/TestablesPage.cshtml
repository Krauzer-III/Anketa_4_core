@model IEnumerable<Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestableView>

<p>
    <a asp-action="Create"><img src="~/css/icons/icons.svg#add-view" height="30" /></a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FilialName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReservLevelName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.YearTraining)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.isArchived)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Code)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FilialName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReservLevelName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.YearTraining)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.isArchived)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"><img src="~/css/icons/icons.svg#edit-view" height="30"/></a>
                    <a asp-action="Details" asp-route-id="@item.Id"><img src="~/css/icons/icons.svg#info-view" height="30" /></a>
                    <a asp-action="Delete" asp-route-id="@item.Id"><img src="~/css/icons/icons.svg#delete-view" height="30" /></a>
                    <a asp-action="Archive" asp-route-id="@item.Id"><img src="~/css/icons/icons.svg#zip-view" height="30" /></a>
                </td>
            </tr>
        }
    </tbody>
</table>
