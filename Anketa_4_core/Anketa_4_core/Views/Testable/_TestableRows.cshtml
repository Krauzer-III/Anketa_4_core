@model IEnumerable<Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestableListItem>
@foreach (var m in Model)
{
    <tr>
        <td>@m.Id</td>
        <td>@m.Code</td>
        <td>@m.Filial</td>
        <td>@m.YearTraining</td>
        <td>@(m.IsArchived ? "Да" : "Нет")</td>
        <td class="text-end">
            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@m.Id">Подробности</a>
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.Id">Редактировать</a>
            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@m.Id">Удалить</a>
        </td>
    </tr>
}
