@model Anketa_4_core.Models.AnketaModels.MVC_Models.MVC_TestableAdd
@using Anketa_4_core.Helpers
@{
    ViewData["Title"] = "Добавить нового тестируемого";
}
<style type="text/css">
    .field-validation-error {
        color: #ff0000;
    }

    .field-validation-valid {
        display: none;
    }

    .input-validation-error {
        border: 1px solid #ff0000;
        background-color: #ffeeee;
    }

    .validation-summary-errors {
        font-weight: bold;
        color: #ff0000;
    }

    .validation-summary-valid {
        display: none;
    }
</style>

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="addOne-tab" data-bs-toggle="tab" data-bs-target="#addOne-tab-pane" type="button" role="tab" aria-controls="addOne-tab-pane" aria-selected="true">addOne</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="addGroup-tab" data-bs-toggle="tab" data-bs-target="#addGroup-tab-pane" type="button" role="tab" aria-controls="addGroup-tab-pane" aria-selected="false">addGroup</button>
    </li>
</ul>
<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade show active" id="addOne-tab-pane" role="tabpanel" aria-labelledby="addOne-tab" tabindex="0">
        @using (Html.BeginForm(FormMethod.Post))
        {
            @Html.DisplayNameFor(m=>m.Code)
            <br />
            @Html.TextBoxFor(m=>m.Code, new {@class="form-control"})
            @Html.ValidationMessageFor(m=>m.Code)
            <hr>
            @Html.DisplayNameFor(m=>m.Filial)
            <br />
            @Html.DDL_Filials(new[] { "form-select" }, "Filial")
            <hr />
            @Html.DisplayNameFor(m=>m.Year)
            <br />
            @Html.DropDownListFor(m=>m.Year, new SelectList(new[] {1,2,3}), new {@class="form-select"})
            <hr />
            @Html.DisplayNameFor(m=>m.RezervLevel)
            <br />
            @Html.DDL_Reservs(new[] { "form-select" }, "RezervLevel")
            <hr />
            <button type="submit" class="btn btn-primary">Добавить</button>
            <hr />

            @Html.RenderUnobtrusiveAjaxScript()
            @Html.ValidationSummary()
        }
    </div>
    <div class="tab-pane fade" id="addGroup-tab-pane" role="tabpanel" aria-labelledby="addGroup-tab" tabindex="0">
        <textarea class="form-control">


            
        </textarea>
        
        @Html.RenderUnobtrusiveAjaxScript()
        @Html.ValidationSummary()
    </div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
