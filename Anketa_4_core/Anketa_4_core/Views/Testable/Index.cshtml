@{
    ViewData["Title"] = "Тестируемые";
}

<section class="app-page-heading">
    <div>
        <span class="app-page-eyebrow">Управление оценкой</span>
        <h1>Тестируемые</h1>
        <p>Поиск сотрудников по коду, просмотр карточек, назначений и результатов.</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-primary" asp-controller="Testable" asp-action="Create">Добавить тестируемого</a>
        <a class="btn btn-outline-primary" asp-controller="Testable" asp-action="Import">Импорт</a>
    </div>
</section>

<div class="card app-data-card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
        <h2 class="h5 mb-0">Список тестируемых</h2>
        <div class="app-search-field">
            <label class="visually-hidden" for="searchBox">Поиск по коду тестируемого</label>
            <input id="searchBox" type="search" class="form-control"
                   autocomplete="off" placeholder="Поиск по коду тестируемого..." />
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Код</th>
                    <th>Филиал</th>
                    <th>Год</th>
                    <th>Архив</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody id="infiniteBody"></tbody>
        </table>
    </div>
    <div id="loading" class="app-list-loading text-muted" role="status" aria-live="polite">
        Загрузка списка...
    </div>
</div>

@section Scripts {
    <script>
        let skip = 0; const take = 30; let done = false; let loading = false; let q = '';
        const body = document.getElementById('infiniteBody');
        const loadingEl = document.getElementById('loading');
        const searchBox = document.getElementById('searchBox');
        let searchRevision = 0;
        let searchDelay = null;

        async function loadMore(reset = false) {
            if (reset) {
                searchRevision++;
                skip = 0;
                done = false;
                body.replaceChildren();
            }
            if (loading || done) return;
            loading = true;
            loadingEl.textContent = 'Загрузка списка...';
            loadingEl.style.display = 'block';
            const revision = searchRevision;
            const url = '@Url.Action("List")?skip=' + skip + '&take=' + take + '&q=' + encodeURIComponent(q);
            try {
                const resp = await fetch(url, { cache: 'no-store' });
                if (!resp.ok) throw new Error('Не удалось загрузить список тестируемых.');
                const html = await resp.text();
                if (revision !== searchRevision) return;
                if (html.trim().length === 0) {
                    done = true;
                    if (skip === 0) {
                        loadingEl.textContent = 'По запросу ничего не найдено.';
                        loadingEl.style.display = 'block';
                    }
                    return;
                }
                body.insertAdjacentHTML('beforeend', html);
                skip += take;
            } catch (error) {
                if (revision === searchRevision) {
                    loadingEl.textContent = error.message || 'Ошибка загрузки.';
                    loadingEl.style.display = 'block';
                    return;
                }
            } finally {
                loading = false;
                if (revision !== searchRevision) {
                    loadMore();
                } else if (!done) {
                    loadingEl.textContent = 'Прокрутите вниз для загрузки следующих записей';
                    loadingEl.style.display = 'block';
                    if (loadingEl.getBoundingClientRect().top < window.innerHeight + 200) {
                        requestAnimationFrame(() => loadMore());
                    }
                } else if (skip > 0) {
                    loadingEl.style.display = 'none';
                }
            }
        }

        const observer = new IntersectionObserver(entries => {
            if (entries[0].isIntersecting) loadMore();
        }, { rootMargin: '200px 0px' });
        observer.observe(loadingEl);

        searchBox.addEventListener('input', () => {
            clearTimeout(searchDelay);
            searchDelay = setTimeout(() => {
                q = searchBox.value.trim();
                loadMore(true);
            }, 250);
        });

        loadMore();
    </script>
}
