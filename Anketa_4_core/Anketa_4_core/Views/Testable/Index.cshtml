@{
    ViewData["Title"] = "Тестируемые";
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-2">Тестируемые</h1>
        <p class="text-muted mb-0">Поиск по коду, список тестируемых и переход к карточкам.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-action="Import">Импорт</a>
        <a class="btn btn-primary" asp-action="Create">Добавить тестируемого</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <label for="searchBox" class="form-label fw-semibold">Поиск тестируемого</label>
        <input id="searchBox" class="form-control" style="max-width:420px"
               placeholder="Введите код или его часть" autocomplete="off" />
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">№</th>
                    <th scope="col">Код</th>
                    <th scope="col">Филиал</th>
                    <th scope="col">Год обучения</th>
                    <th scope="col">Архив</th>
                    <th scope="col">Действия</th>
                </tr>
            </thead>
            <tbody id="infiniteBody"></tbody>
        </table>
    </div>
    <div id="loading" class="text-muted text-center p-3" role="status">Загрузка записей...</div>
</div>

@section Scripts {
    <script>
        let skip = 0; const take = 30; let done = false; let loading = false; let q = '';
        const body = document.getElementById('infiniteBody');
        const loadingEl = document.getElementById('loading');
        const searchBox = document.getElementById('searchBox');

        async function loadMore(reset = false) {
            if (loading || done) return; loading = true; loadingEl.style.display = 'block';
            const url = `@Url.Action("List")?skip=${reset ? 0 : skip}&take=${take}&q=${encodeURIComponent(q)}`;
            const resp = await fetch(url);
            const html = await resp.text();
            if (reset) { body.innerHTML = ''; skip = 0; done = false; }
            if (html.trim().length === 0) { done = true; }
            else { body.insertAdjacentHTML('beforeend', html); skip += take; }
            loading = false; loadingEl.style.display = 'none';
        }

        const observer = new IntersectionObserver(entries => {
            if (entries[0].isIntersecting) { loadMore(); }
        });
        observer.observe(loadingEl);

        searchBox.addEventListener('input', () => {
            q = searchBox.value || '';
            done = false; skip = 0; loadMore(true);
        });

        loadMore();
    </script>
}
