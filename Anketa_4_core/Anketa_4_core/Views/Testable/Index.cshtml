@{
    ViewData["Title"] = "Тестируемые";
}

<h2 class="mb-3">Тестируемые</h2>
<div class="d-flex gap-2 mb-3">
    <a class="btn btn-primary" asp-action="Create">Добавить тестируемого</a>
    <input id="searchBox" class="form-control" style="max-width: 320px" placeholder="Поиск по коду..." />
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Код</th>
            <th>Филиал</th>
            <th>Год</th>
            <th>Архив</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="infiniteBody"></tbody>
</table>

<div id="loading" class="text-muted">Загрузка...</div>

@section Scripts {
    <script>
        let skip = 0; const take = 30; let done = false; let loading = false; let q = '';
        const body = document.getElementById('infiniteBody');
        const loadingEl = document.getElementById('loading');
        const searchBox = document.getElementById('searchBox');

        async function loadMore(reset = false) {
            if (loading || done) return; loading = true; loadingEl.style.display = 'block';
            const url = `@Url.Action("List")?skip=${reset ? 0 : skip}&take=${take}&q=${encodeURIComponent(q)}`;
            const resp = await fetch(url);
            const html = await resp.text();
            if (reset) { body.innerHTML = ''; skip = 0; done = false; }
            if (html.trim().length === 0) { done = true; }
            else { body.insertAdjacentHTML('beforeend', html); skip += take; }
            loading = false; loadingEl.style.display = 'none';
        }

        const observer = new IntersectionObserver(entries => {
            if (entries[0].isIntersecting) { loadMore(); }
        });
        observer.observe(loadingEl);

        searchBox.addEventListener('input', () => {
            q = searchBox.value || '';
            done = false; skip = 0; loadMore(true);
        });

        loadMore();
    </script>
}
