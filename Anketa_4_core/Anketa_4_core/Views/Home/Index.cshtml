@{
    ViewData["Title"] = "Главная";
    bool signedIn = User.Identity?.IsAuthenticated == true;
    bool filial = User.IsInRole("filial_user");
    bool manage = User.IsInRole("admin") || User.IsInRole("moderator");
    bool review = manage || User.IsInRole("verificator");
}

<h2 class="my-4">Автоматизированная система «Оценка персонала»</h2>

@if (!signedIn)
{
    <p>Для работы с системой войдите в свою учётную запись.</p>
    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Войти в систему</a>
}
else if (filial)
{
    <p class="text-muted">Выберите вид тестирования. Далее потребуется код сотрудника.</p>
    <div class="list-group mb-4">
        <a class="list-group-item list-group-item-action" asp-controller="Test360" asp-action="StartTest">Оценка 360°</a>
        <a class="list-group-item list-group-item-action" asp-controller="Motivation" asp-action="Index">Мотивационный опросник</a>
        <a class="list-group-item list-group-item-action" asp-controller="Kettel" asp-action="Index">Психологическое тестирование</a>
        <a class="list-group-item list-group-item-action" asp-controller="Competention" asp-action="Index" asp-route-year="1">Компетенции (1 год)</a>
        <a class="list-group-item list-group-item-action" asp-controller="Competention" asp-action="Index" asp-route-year="2">Компетенции (2 год)</a>
    </div>
}
else if (review)
{
    <p class="text-muted">Рабочие разделы также доступны в меню слева.</p>
    <div class="list-group mb-4">
        <a class="list-group-item list-group-item-action" asp-controller="Result" asp-action="IndexModerator">Просмотр результатов</a>
        <a class="list-group-item list-group-item-action" asp-controller="Period" asp-action="Index">Периоды тестирования</a>
        @if (manage)
        {
            <a class="list-group-item list-group-item-action" asp-controller="Testable" asp-action="Index">Тестируемые</a>
            <a class="list-group-item list-group-item-action" asp-controller="Registration" asp-action="Index">Регистрация пользователей</a>
            <a class="list-group-item list-group-item-action" asp-controller="NewsAdmin" asp-action="Index">Управление новостями</a>
        }
        @if (User.IsInRole("admin"))
        {
            <a class="list-group-item list-group-item-action" asp-controller="Users" asp-action="Index">Пользователи системы</a>
        }
    </div>
}
else
{
    <p>Для этой учётной записи рабочие разделы не назначены. Обратитесь к администратору.</p>
}
