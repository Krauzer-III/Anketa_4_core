@page
@model LoginModel
@{
    ViewData["Title"] = "Вход в систему";
}
<div class="auth-wrap">
    <div class="auth-intro">
        <span class="auth-intro__eyebrow">Автоматизированная система</span>
        <h1>Оценка персонала</h1>
        <p>Пройдите тестирование, заполните индивидуальный план подготовки или откройте рабочую панель — доступные возможности зависят от вашей учётной записи.</p>
    </div>
    <div class="auth-panel">
        <h2>Вход в систему</h2>
        <p>Укажите логин и пароль, выданные администратором.</p>
        <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="form-floating">
                <input asp-for="Input.UserName" class="form-control" autocomplete="username"
                       placeholder="Логин" aria-required="true" />
                <label asp-for="Input.UserName">Логин</label>
                <span asp-validation-for="Input.UserName" class="text-danger small"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                       placeholder="Пароль" aria-required="true" />
                <label asp-for="Input.Password">Пароль</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="form-check auth-panel__remember">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">Запомнить меня</label>
            </div>
            <button id="login-submit" type="submit" class="btn btn-primary w-100 auth-panel__submit">
                Войти
            </button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
